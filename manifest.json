{
  "manifest_version": 3,
  "name": "新标签页导航",
  "version": "1.0.0",
  "description": "简洁美观的新标签页导航：问候语、搜索栏、分类书签网格",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage", "unlimitedStorage", "favicon", "history", "search", "bookmarks"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
